<% layout("./layouts/boilerplate") -%>

<div class="row">
    <h1 class="col-8 offset-3">Signup On Wanderlust</h1>
        <div class="col-8 offset-3">
            <form action="/signup" method="post" class="needs-validation" novalidate>
                    <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input type="text" name="username" placeholder="title" class="form-control" required>
        <div class="valid-feedback">User is good!</div>
        <div class="invalid-feedback">user is required</div>
        </div>
         <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input type="email" name="email" placeholder="email" class="form-control" required>
        <div class="valid-feedback">Email is good!</div>
        <div class="invalid-feedback">email is required</div>
        </div>
        <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input type="password" name="password" placeholder="password" class="form-control" required>
        <div class="valid-feedback">Email is good!</div>
        <div class="invalid-feedback">password is required</div>
        </div>
        <button class="btn btn-success">Signup</button>       
            </form>
        </div>
</div>